#include <iostream>
#include <cstring>
using namespace std;
#define INF 9999999
#define V 8
// Матриця суміжності графа
int G[V][V] = {
    {0,   INF,  6,   7,  INF, INF,  INF, INF},
    {INF,  0,  INF,  3,   4,   2,   INF, INF},
    {6,   INF,  0,  INF, INF,  3,   INF,  7},
    {7,    3,  INF,  0,   9,  INF,  INF, INF},
    {INF,  4,  INF,  9,   0,  INF,   5,  INF},
    {INF,  2,   3,  INF, INF,  0,    9,   3},
    {INF, INF, INF, INF,  5,   9,    0,  INF},
    {INF, INF,  7,  INF, INF,  3,   INF,   0}
};

int main() {
    int selected[V];
    memset(selected, false, sizeof(selected));
    int no_edge = 0;
    selected[0] = true;

    cout << "Edge" << " : " << "Weight" << endl;

    while (no_edge < V - 1) {
        int min = INF;
        int x = 0;
        int y = 0;

        for (int i = 0; i < V; i++) {
            if (selected[i]) {
                for (int j = 0; j < V; j++) {
                    if (!selected[j] && G[i][j] != INF && G[i][j] != 0) {
                        if (min > G[i][j]) {
                            min = G[i][j];
                            x = i;
                            y = j;
                        }
                    }
                }
            }
        }
        cout << (x + 1) << " - " << (y + 1) << " : " << G[x][y] << endl;
        selected[y] = true;
        no_edge++;
    }
    return 0;
}
