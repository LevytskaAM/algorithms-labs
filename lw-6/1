// Алгоритм Дейкстри
#include <iostream>
#include <vector>
#include <limits>
using namespace std;
const int INF = 1e9;
const int V = 8;

int W[V][V] = {
    {0,   INF, 6,   7,   INF, 8,   INF, INF},
    {INF, 0,   INF, 3,   4,   2,   INF, INF},
    {6,   INF, 0,   INF, INF, 3,   INF, 7  },
    {7,   3,   INF, 0,   9,   INF, INF, INF},
    {INF, 4,   INF, 9,   0,   INF, 5,   INF},
    {8,   2,   3,   INF, INF, 0,   9,   3  },
    {INF, INF, INF, INF, 5,   9,   0,   INF},
    {INF, INF, 7,   INF, INF, 3,   INF, 0  }
};

void dijkstra(int start) {
    vector<int> dist(V, INF);
    vector<int> pred(V, -1);
    vector<bool> visited(V, false);
    dist[start] = 0;

    for (int i = 0; i < V; ++i) {
        int u = -1;
        for (int j = 0; j < V; ++j) {
            if (!visited[j] && (u == -1 || dist[j] < dist[u])) {
                u = j;
            }
        }
        if (u == -1 || dist[u] == INF) break;
        visited[u] = true;

        for (int v = 0; v < V; ++v) {
            if (W[u][v] != INF && dist[u] + W[u][v] < dist[v]) {
                dist[v] = dist[u] + W[u][v];
                pred[v] = u + 1;
            }
        }
    }

    cout << "--- Результати алгоритму Дейкстри від вершини " << start + 1 << " ---" << endl;
    for (int i = 0; i < V; ++i) {
        cout << "До вершини " << i + 1 << ": відстань = " << dist[i]
             << " (попередник: " << pred[i] << ")" << endl;
    }
}

int main() {
    dijkstra(0); // Від вершини 1 (індекс 0)
    return 0;
}
